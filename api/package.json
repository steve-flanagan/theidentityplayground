{
  "name": "api",
  "version": "1.0.0",
  "description": "Identity Playground backend — Azure Functions (Node, TypeScript)",
  "private": true,
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.1",
    "@azure/functions": "^4.0.0",
    "@azure/identity": "^4.10.0",
    "@azure/keyvault-secrets": "^4.11.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "rimraf": "^5.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
